  * KosmicKrisp semaphore is one). Lets Metal work outside the driver (MetalFX) wait for and
  * signal Vulkan timelines on the GPU. Other export requests are left unfilled (null). */
 VKAPI_ATTR void VKAPI_CALL
-kk_ExportMetalObjectsEXT(UNUSED VkDevice device,
+kk_ExportMetalObjectsEXT(VkDevice device,
                          VkExportMetalObjectsInfoEXT *pMetalObjectsInfo)
 {
    for (VkBaseOutStructure *ext = (VkBaseOutStructure *)pMetalObjectsInfo->pNext;
         ext != NULL; ext = ext->pNext) {
+      /* bbport 0007 (spike/metalfx-tail): the MTLDevice and the MTLTexture backing a
+       * VkImage / VkImageView plane, so Metal code (MetalFX) can read and write KosmicKrisp's
+       * own images with no copy. KK has no MTLCommandQueue to give (its queue is an
+       * MTL4CommandQueue), so METAL_COMMAND_QUEUE is still left null. */
+      if (ext->sType == VK_STRUCTURE_TYPE_EXPORT_METAL_DEVICE_INFO_EXT) {
+         VK_FROM_HANDLE(kk_device, dev, device);
+         ((VkExportMetalDeviceInfoEXT *)ext)->mtlDevice =
+            (MTLDevice_id)dev->mtl_handle;
+         continue;
+      }
+      if (ext->sType == VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT) {
+         VkExportMetalTextureInfoEXT *info = (VkExportMetalTextureInfoEXT *)ext;
+         info->mtlTexture = NULL;
+         if (info->image != VK_NULL_HANDLE) {
+            VK_FROM_HANDLE(kk_image, image, info->image);
+            /* The spec's plane is VK_IMAGE_ASPECT_PLANE_{0,1,2}_BIT; single-plane
+             * images (all of the port's) answer plane 0 for any other value. */
+            uint8_t p = info->plane == VK_IMAGE_ASPECT_PLANE_1_BIT   ? 1
+                        : info->plane == VK_IMAGE_ASPECT_PLANE_2_BIT ? 2
+                                                                     : 0;
+            if (p < image->plane_count)
+               info->mtlTexture = (MTLTexture_id)image->planes[p].mtl_handle;
+         } else if (info->imageView != VK_NULL_HANDLE) {
+            VK_FROM_HANDLE(kk_image_view, view, info->imageView);
+            info->mtlTexture =
+               (MTLTexture_id)view->planes[0].mtl_handle_sampled;
+         }
+         continue;
+      }
       if (ext->sType != VK_STRUCTURE_TYPE_EXPORT_METAL_SHARED_EVENT_INFO_EXT)
          continue;
