 #import <QuartzCore/CAMetalLayer.h>
 #import <Metal/Metal.h>
 
+#include <stdio.h>
+#include <stdlib.h>
+#include <mach/mach_time.h>
+
+/* bbport (BB_COMMIT_TRACE, docs/FRAME_HANDOFF_WAIT.md): the presenter side of the frame-handoff
+ * counter. The counter itself lives in the driver (kk_queue.c, which also owns the commit lines
+ * and the draws-in-flight total); this file only says when a drawable was acquired and how long
+ * the acquire blocked. The WSI is device-agnostic and cannot include the driver's headers, so the
+ * two entry points are declared here. */
+extern bool kk_commit_trace_enabled(void);
+extern void kk_commit_trace_drawable_acquired(void);
+extern uint32_t kk_commit_trace_inflight(void);
+
+static int64_t
+wsi_trace_now_ns(void)
+{
+   static mach_timebase_info_data_t tb;
+   if (tb.denom == 0)
+      mach_timebase_info(&tb);
+   const uint64_t t = mach_absolute_time();
+   return (int64_t)((t / tb.denom) * tb.numer + ((t % tb.denom) * tb.numer) / tb.denom);
+}
+
+/* BB_DRAWABLES=<n>: the layer's drawable pool size, in place of the swapchain's image count (a
+ * present experiment, default off — the pool is what a GPU present can run out of when the
+ * compositor still holds a drawable). Never below the swapchain's image count: the Vulkan WSI
+ * acquires one drawable per image and would otherwise time out. */
+static uint32_t
+wsi_drawable_count(uint32_t image_count)
+{
+   const char *env = getenv("BB_DRAWABLES");
+   if (env == NULL || env[0] == '\0')
+      return image_count;
+   const long n = strtol(env, NULL, 10);
+   if (n < (long)image_count)
+      return image_count;
+   return (uint32_t)n;
+}
