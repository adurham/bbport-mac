 #include "nir_builder.h"
 #include "nir_lower_blend.h"
 
+/* bbport (BB_KK_TIMING): the driver's own layers, per pipeline, on stderr.
+ *
+ * A graphics pipeline the port creates costs three separate things here: SPIR-V->NIR->MSL (skipped
+ * when the driver's on-disk shader cache holds it), Metal's MTLLibrary for the generated MSL (never
+ * cached: MSL is source text), and Metal's render pipeline state (never cached either). One line
+ * per graphics pipeline, so the port's own per-pipeline line (BB_PIPE_TIMING) can be split by
+ * layer. Off unless BB_KK_TIMING names a file; it reads the clock and prints, nothing else. */
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "util/os_time.h"
+
+static _Thread_local int64_t kk_t_nir_msl_ns; /* the MSL compile that preceded this pipeline */
+static _Thread_local int kk_t_cache_hit;      /* the shader came back from the disk cache */
+
+static FILE *
+kk_timing_file(void)
+{
+   static FILE *file;
+   static bool tried;
+   if (!tried) {
+      tried = true;
+      const char *path = getenv("BB_KK_TIMING");
+      if (path != NULL && path[0] != '\0')
+         file = fopen(path, "a");
+   }
+   return file;
+}
+
+static void
+kk_timing_report(int64_t lib_ns, int64_t pso_ns)
+{
+   FILE *file = kk_timing_file();
+   if (file == NULL)
+      return;
+   fprintf(file, "KKPIPE tid=%lu hit=%d nir_msl_us=%.1f lib_us=%.1f pso_us=%.1f\n",
+           (unsigned long)pthread_self(), kk_t_cache_hit, kk_t_nir_msl_ns / 1000.0,
+           lib_ns / 1000.0, pso_ns / 1000.0);
+   fflush(file);
+   kk_t_cache_hit = 0;
+   kk_t_nir_msl_ns = 0;
+}
+
 #include "poly/nir/poly_nir.h"
 
 #include "vk_blend.h"
