+bool
+kk_bb_transfer_wait(void)
+{
+   static int on = -1;
+   int v = p_atomic_read(&on);
+   if (v < 0) {
+      v = debug_get_bool_option("BB_KK_TRANSFER_WAIT", true) ? 1 : 0;
+      p_atomic_set(&on, v);
+      if (!v)
+         fprintf(stderr, "KosmicKrisp: transfer-destination barriers are not "
+                         "vertex-side (BB_KK_TRANSFER_WAIT=0, vk mode only)\n");
+   }
+   return v != 0;
+}
