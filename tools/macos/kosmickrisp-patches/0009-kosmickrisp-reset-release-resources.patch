+/* bbport (0009): VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT. Without it,
+ * each live command buffer keeps three MTL4CommandAllocators whose reset keeps
+ * their memory, so a pool's load-spike high-water stays resident forever.
+ *
+ * Releases the encoder states' Metal objects in dependency order: the three
+ * encoders, then the three MTL4CommandBuffers, then the three
+ * MTL4CommandAllocators, and NULLs every pointer. It runs after
+ * kk_reset_cmd_buffer_internal, whose two cs_end() calls have already ended
+ * every encoder and moved every MTL4CommandBuffer into submit_cmd_bufs, which
+ * kk_cmd_release_resources then released; so the encoder and command buffer
+ * steps only enforce that invariant, and no command buffer that was encoded
+ * from these allocators is still referenced when they go.
+ *
+ * SAFETY: called ONLY from kk_reset_cmd_buffer_release, i.e. only when the
+ * caller of the reset passed RELEASE_RESOURCES_BIT. Every such caller is an
+ * application entry point (vkResetCommandBuffer, vkResetCommandPool with
+ * VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT, and the common runtime's
+ * recycle on vkFreeCommandBuffers / a failed vkAllocateCommandBuffers) whose
+ * valid usage forbids a command buffer in the pending state: the application
+ * has synchronised with every submission of this buffer, so nothing encoded
+ * from these allocators is in flight. That is the same guarantee the plain
+ * reset already relies on for -[MTL4CommandAllocator reset]. Driver-internal
+ * paths (the queue's re-record recycling and its pool reset, submit, destroy,
+ * trim) never pass the flag and must never call this: no sweep, no timer. */
+static void
+kk_cmd_buffer_release_mtl(struct kk_cmd_buffer *cmd)
+{
+   struct kk_encoder_state *const states[] = {cmd->pre_gfx, &cmd->gfx,
+                                              cmd->post_gfx};
+
+   if (cmd->bb_mtl_released)
+      return; /* double reset-with-release: no-op */
+
+   /* 1. encoders */
+   for (unsigned i = 0; i < ARRAY_SIZE(states); i++) {
+      struct kk_encoder_state *es = states[i];
+      assert(es->encoder == NULL);
+      if (es->encoder) {
+         mtl_end_encoding(es->encoder);
+         mtl_release(es->encoder);
+         es->encoder = NULL;
+      }
+   }
+   /* 2. MTL4CommandBuffers */
+   for (unsigned i = 0; i < ARRAY_SIZE(states); i++) {
+      struct kk_encoder_state *es = states[i];
+      assert(es->cmd_buf == NULL);
+      if (es->cmd_buf) {
+         mtl_release(es->cmd_buf);
+         kk_bbstat_add(KK_BBSTAT_MTL_CMD_BUFS_RELEASED, 1);
+         es->cmd_buf = NULL;
+      }
+   }
+   /* 3. MTL4CommandAllocators */
+   for (unsigned i = 0; i < ARRAY_SIZE(states); i++) {
+      struct kk_encoder_state *es = states[i];
+      if (es->allocator) {
+         /* What the allocator still holds after its reset (reset keeps the
+          * allocation), i.e. what this release returns. The "holding" total
+          * drops by its own last sample (bb_allocated_B, BB_KK_STATS=1). */
+         const uint64_t held_B = mtl_command_allocator_allocated_size(es->allocator);
+         kk_bbstat_add(KK_BBSTAT_ALLOCATORS, -1);
+         kk_bbstat_add(KK_BBSTAT_ALLOCATOR_BYTES, -(int64_t)es->bb_allocated_B);
+         kk_bbstat_add(KK_BBSTAT_ALLOCATORS_RELEASED, 1);
+         kk_bbstat_add(KK_BBSTAT_ALLOCATOR_RELEASED_BYTES, held_B);
+         mtl_release(es->allocator);
+         es->allocator = NULL;
+      }
+      es->bb_allocated_B = 0u;
+   }
+   cmd->bb_mtl_released = true;
+}
+
+/* bbport (0009): recreate what kk_cmd_buffer_release_mtl released, at begin.
+ * The MTL4CommandBuffers need nothing here: every encoder start creates its
+ * own (cs_start_render, kk_start_compute_encoder). */
+static bool
+kk_cmd_buffer_recreate_mtl(struct kk_cmd_buffer *cmd)
+{
+   if (!kk_encoder_state_allocator(cmd, cmd->pre_gfx) ||
+       !kk_encoder_state_allocator(cmd, &cmd->gfx) ||
+       !kk_encoder_state_allocator(cmd, cmd->post_gfx))
+      return false;
+   cmd->bb_mtl_released = false;
+   return true;
+}
+
+/* bbport (0009): reset with VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT:
+ * the ordinary reset, then release the allocators. A buffer whose allocators
+ * are already released has recorded nothing since (kk_BeginCommandBuffer
+ * recreates them before anything can be recorded), so it is already in the
+ * fully reset state and a second reset-with-release is a no-op. */
+static void
+kk_reset_cmd_buffer_release(struct kk_cmd_buffer *cmd)
+{
+   if (cmd->bb_mtl_released)
+      return;
+
+   vk_command_buffer_reset(&cmd->vk);
+   kk_reset_cmd_buffer_internal(cmd);
+   kk_cmd_buffer_release_mtl(cmd);
+   cmd->submitted = false;
+   cmd->one_time_submit = false;
+}
