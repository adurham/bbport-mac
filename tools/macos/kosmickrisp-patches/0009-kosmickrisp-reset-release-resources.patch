+/* bbport (0009): vk_common_ResetCommandBuffer, except that a reset with
+ * RELEASE_RESOURCES_BIT also reaches a command buffer in the initial state that
+ * still holds its allocators (e.g. one reset without the flag earlier). Without
+ * the flag this is exactly the common implementation. */
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_ResetCommandBuffer(VkCommandBuffer commandBuffer,
+                      VkCommandBufferResetFlags flags)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
