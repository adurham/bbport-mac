+   if (unlikely(flags & VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT)) {
+      kk_reset_cmd_buffer_release(cmd);
+      return;
+   }
+
    vk_command_buffer_reset(&cmd->vk);
    kk_reset_cmd_buffer_internal(cmd);
    cmd->submitted = false;
