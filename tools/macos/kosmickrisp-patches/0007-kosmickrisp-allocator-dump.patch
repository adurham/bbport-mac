+/* bbport (BB_KK_STATS): every live kk_cmd_buffer, for the one-shot allocator dump. */
+static struct list_head bb_cmd_buffers = {&bb_cmd_buffers, &bb_cmd_buffers};
+static simple_mtx_t bb_cmd_buffers_lock = SIMPLE_MTX_INITIALIZER;
+
+void
+kk_bb_cmd_buffer_register(struct kk_cmd_buffer *cmd)
+{
+   cmd->bb_registered = false;
+   if (!kk_bbstats_enabled())
+      return;
+   simple_mtx_lock(&bb_cmd_buffers_lock);
+   list_addtail(&cmd->bb_link, &bb_cmd_buffers);
+   cmd->bb_registered = true;
+   simple_mtx_unlock(&bb_cmd_buffers_lock);
+}
+
+void
+kk_bb_cmd_buffer_unregister(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->bb_registered)
+      return;
+   simple_mtx_lock(&bb_cmd_buffers_lock);
+   list_del(&cmd->bb_link);
+   cmd->bb_registered = false;
+   simple_mtx_unlock(&bb_cmd_buffers_lock);
+}
+
+struct bb_pool_row {
+   struct kk_cmd_pool *pool;
+   unsigned buffers, recording, executable, pending, initial;
+   uint64_t bytes, max_B, per_state_B[3];
+};
+
+static int
+bb_cmp_u64_desc(const void *a, const void *b)
+{
+   const uint64_t x = *(const uint64_t *)a, y = *(const uint64_t *)b;
+   return x < y ? 1 : x > y ? -1 : 0;
+}
+
+static void
+kk_bb_alloc_dump(double at_s)
+{
+   enum { MaxPools = 32, MaxBuffers = 8192 };
+   static struct bb_pool_row rows[MaxPools];
+   static uint64_t sizes[MaxPools][MaxBuffers];
+   unsigned npools = 0, overflow = 0;
+   memset(rows, 0, sizeof(rows));
+
+   simple_mtx_lock(&bb_cmd_buffers_lock);
+   list_for_each_entry(struct kk_cmd_buffer, cmd, &bb_cmd_buffers, bb_link) {
+      struct kk_cmd_pool *pool = kk_cmd_buffer_pool(cmd);
+      unsigned r = 0;
+      while (r < npools && rows[r].pool != pool)
+         r++;
+      if (r == npools) {
+         if (npools == MaxPools) {
+            overflow++;
+            continue;
+         }
+         rows[npools++].pool = pool;
+      }
+      struct bb_pool_row *row = &rows[r];
+      /* allocatedSize as of each allocator's last reset (the same numbers the running total in
+       * "command allocators N holding M MiB" adds up): no Metal call from this thread. */
+      const uint64_t pre = cmd->pre_gfx->bb_allocated_B, gfx = cmd->gfx.bb_allocated_B,
+                     post = cmd->post_gfx->bb_allocated_B;
+      const uint64_t total = pre + gfx + post;
+      if (row->buffers < MaxBuffers)
+         sizes[r][row->buffers] = total;
+      row->buffers++;
+      row->bytes += total;
+      row->per_state_B[0] += pre;
+      row->per_state_B[1] += gfx;
+      row->per_state_B[2] += post;
+      if (total > row->max_B)
+         row->max_B = total;
+      switch (cmd->vk.state) {
+      case MESA_VK_COMMAND_BUFFER_STATE_RECORDING: row->recording++; break;
+      case MESA_VK_COMMAND_BUFFER_STATE_EXECUTABLE: row->executable++; break;
+      case MESA_VK_COMMAND_BUFFER_STATE_PENDING: row->pending++; break;
+      default: row->initial++; break;
+      }
+   }
+   simple_mtx_unlock(&bb_cmd_buffers_lock);
+
+   uint64_t all = 0;
+   unsigned nbufs = 0;
+   for (unsigned r = 0; r < npools; r++) {
+      all += rows[r].bytes;
+      nbufs += rows[r].buffers;
+   }
+   fprintf(stderr,
+           "KosmicKrisp allocator dump at %.0f s: %u command buffers (%u allocators) in %u pools "
+           "hold %llu MiB%s\n",
+           at_s, nbufs, nbufs * 3u, npools, (unsigned long long)(all >> 20),
+           overflow ? " (pools beyond 32 not shown)" : "");
+   for (unsigned r = 0; r < npools; r++) {
+      struct bb_pool_row *row = &rows[r];
+      const unsigned n = row->buffers < MaxBuffers ? row->buffers : MaxBuffers;
+      qsort(sizes[r], n, sizeof(uint64_t), bb_cmp_u64_desc);
+      uint64_t top4 = 0;
+      for (unsigned i = 0; i < n && i < 4; i++)
+         top4 += sizes[r][i];
+      const uint64_t median = n ? sizes[r][n / 2] : 0;
+      fprintf(stderr,
+              "KosmicKrisp allocator dump: pool %u: %u buffers, %llu MiB (pre_gfx %llu, gfx %llu, "
+              "post_gfx %llu); per buffer max %.1f / median %.1f MiB, top 4 hold %llu MiB; "
+              "states now: %u recording, %u executable, %u pending, %u initial; most recording "
+              "at once %d\n",
+              row->pool->bb_id, row->buffers, (unsigned long long)(row->bytes >> 20),
+              (unsigned long long)(row->per_state_B[0] >> 20),
+              (unsigned long long)(row->per_state_B[1] >> 20),
+              (unsigned long long)(row->per_state_B[2] >> 20), row->max_B / 1048576.0,
+              median / 1048576.0, (unsigned long long)(top4 >> 20), row->recording,
+              row->executable, row->pending, row->initial,
+              p_atomic_read(&row->pool->bb_recording_max));
+      /* Every buffer's MiB, largest first, so the shape of the hold is in the log. */
+      char line[4096];
+      int used = 0;
+      for (unsigned i = 0; i < n && used < (int)sizeof(line) - 16; i++)
+         used += snprintf(line + used, sizeof(line) - used, "%s%.1f", i ? " " : "",
+                          sizes[r][i] / 1048576.0);
+      fprintf(stderr, "KosmicKrisp allocator dump: pool %u sizes MiB: %s\n", row->pool->bb_id,
+              line);
+   }
+}
+
+void
+kk_bb_alloc_dump_maybe(void)
+{
+   static int64_t start_ns = 0;
+   static int done_mask = 0;
+   static double at[2] = {-1.0, -1.0};
+   static int parsed = 0;
+   if (!kk_bbstats_enabled())
+      return;
+   if (!p_atomic_read(&parsed)) {
+      const char *v = getenv("BB_KK_ALLOC_DUMP");
+      if (v && *v) {
+         char *end = NULL;
+         at[0] = strtod(v, &end);
+         if (end && *end == ',')
+            at[1] = strtod(end + 1, NULL);
+      }
+      p_atomic_set(&start_ns, os_time_get_nano());
+      p_atomic_set(&parsed, 1);
+   }
+   const double t = (os_time_get_nano() - p_atomic_read(&start_ns)) / 1e9;
+   for (int i = 0; i < 2; i++) {
+      if (at[i] < 0.0 || t < at[i] || (p_atomic_read(&done_mask) & (1 << i)))
+         continue;
+      const int seen = p_atomic_read(&done_mask);
+      if (p_atomic_cmpxchg(&done_mask, seen, seen | (1 << i)) != seen)
+         continue;
+      kk_bb_alloc_dump(t);
+   }
+}
