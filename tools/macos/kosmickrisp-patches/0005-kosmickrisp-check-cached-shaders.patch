+   const size_t left = blob->overrun ? 0u : (size_t)(blob->end - blob->current);
+   if (entrypoint_length == 0u || code_length == 0u || entrypoint_length > left ||
+       code_length > left - entrypoint_length)
+      return VK_ERROR_INCOMPATIBLE_SHADER_BINARY_EXT;
    data->entrypoint_name = ralloc_array(NULL, char, entrypoint_length);
