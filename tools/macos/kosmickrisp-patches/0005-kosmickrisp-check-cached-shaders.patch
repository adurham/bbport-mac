+/* bbport: a shader's info from the on-disk cache, checked before it indexes anything (stage
+ * arrays, the pipeline's pre-render list, the static GS topology copied at draw time). */
+static bool
+kk_shader_info_valid(const struct kk_shader_info *info)
+{
+   if ((unsigned)info->stage >= MESA_SHADER_STAGES)
+      return false;
+   if (info->stage == MESA_SHADER_VERTEX) {
+      const uint32_t allowed = BITFIELD_BIT(MESA_SHADER_TESS_CTRL) |
+                               BITFIELD_BIT(MESA_SHADER_TESS_EVAL) |
+                               BITFIELD_BIT(MESA_SHADER_GEOMETRY) |
+                               BITFIELD_BIT(MESA_SHADER_FRAGMENT);
+      const uint32_t bits = info->vs.additional_stages_bits;
+      /* pre_render_count is the bit count minus one, plus one for a GS: at most 4 */
+      if ((bits & ~allowed) != 0u || util_bitcount(bits) == 0u || util_bitcount(bits) > 4u)
+         return false;
+   }
+   if (info->stage == MESA_SHADER_GEOMETRY) {
+      if ((unsigned)info->gs.shape > (unsigned)POLY_GS_SHAPE_STATIC_PER_INSTANCE)
+         return false;
+      if (info->gs.shape == POLY_GS_SHAPE_STATIC_INDEXED &&
+          info->gs.max_indices > ARRAY_SIZE(info->gs.topology))
+         return false;
+   }
+   return true;
+}
