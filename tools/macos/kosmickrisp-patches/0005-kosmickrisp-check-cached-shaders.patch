+/* bbport: a shader's info from the on-disk cache, checked before it indexes anything (stage
+ * arrays, the pipeline's pre-render list, the static GS topology copied at draw time) or reaches
+ * a switch without a default. Against corrupt entries: shaders that don't match each other
+ * (each entry is checked alone) are not caught, and whoever can write this cache can write the
+ * driver next to it too. */
+static bool
+kk_shader_info_valid(const struct kk_shader_info *info)
+{
+   if ((unsigned)info->stage >= MESA_SHADER_STAGES)
+      return false;
+   if (info->stage == MESA_SHADER_VERTEX) {
+      const uint32_t allowed = BITFIELD_BIT(MESA_SHADER_TESS_CTRL) |
+                               BITFIELD_BIT(MESA_SHADER_TESS_EVAL) |
+                               BITFIELD_BIT(MESA_SHADER_GEOMETRY) |
+                               BITFIELD_BIT(MESA_SHADER_FRAGMENT);
+      const uint32_t bits = info->vs.additional_stages_bits;
+      const uint32_t tess = BITFIELD_BIT(MESA_SHADER_TESS_CTRL) |
+                            BITFIELD_BIT(MESA_SHADER_TESS_EVAL);
+      /* Always an FS (an empty one is added); TCS and TES together; pre_render_count is the
+       * bit count minus one, plus one for a GS: at most 4. */
+      if ((bits & ~allowed) != 0u || !(bits & BITFIELD_BIT(MESA_SHADER_FRAGMENT)) ||
+          ((bits & tess) != 0u && (bits & tess) != tess) || util_bitcount(bits) > 4u)
+         return false;
+      /* Passed to switches whose default is unreachable (vk_to_mtl_map.c). */
+      if (info->vs.has_ds && (unsigned)info->vs.depth_compare_op > VK_COMPARE_OP_ALWAYS)
+         return false;
+      if (info->vs.has_stencil_test &&
+          (info->vs.stencil_front.compare > VK_COMPARE_OP_ALWAYS ||
+           info->vs.stencil_back.compare > VK_COMPARE_OP_ALWAYS))
+         return false;
+   }
+   if (info->stage == MESA_SHADER_GEOMETRY) {
+      if ((unsigned)info->gs.shape > (unsigned)POLY_GS_SHAPE_STATIC_PER_INSTANCE)
+         return false;
+      /* The rasterization primitive (mesa_prim_to_mtl_primitive_type: unreachable default) */
+      switch (info->gs.mode) {
+      case MESA_PRIM_POINTS:
+      case MESA_PRIM_LINES:
+      case MESA_PRIM_LINE_STRIP:
+      case MESA_PRIM_TRIANGLES:
+      case MESA_PRIM_TRIANGLE_STRIP:
+         break;
+      default:
+         return false;
+      }
+      if (info->gs.shape == POLY_GS_SHAPE_STATIC_INDEXED &&
+          info->gs.max_indices > ARRAY_SIZE(info->gs.topology))
+         return false;
+   }
+   return true;
+}
