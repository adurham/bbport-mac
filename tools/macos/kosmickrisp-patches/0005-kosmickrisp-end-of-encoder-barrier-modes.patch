+kk_bb_barrier_mode(void)
+{
+   static int mode = -1;
+   int m = p_atomic_read(&mode);
+   if (m < 0) {
+      const char *v = debug_get_option("BB_KK_BARRIER", "legacy");
+      m = !strcmp(v, "lite")    ? KK_BB_BARRIER_LITE
+          : !strcmp(v, "nodep") ? KK_BB_BARRIER_NODEP
+          : !strcmp(v, "none")  ? KK_BB_BARRIER_NONE
+          : !strcmp(v, "vk")    ? KK_BB_BARRIER_VK
+                                : KK_BB_BARRIER_LEGACY;
+      p_atomic_set(&mode, m);
+      fprintf(stderr, "KosmicKrisp: end-of-encoder barriers: %s (BB_KK_BARRIER)\n",
+              m == KK_BB_BARRIER_LITE    ? "lite"
+              : m == KK_BB_BARRIER_NODEP ? "nodep (diagnostic, unsafe)"
+              : m == KK_BB_BARRIER_NONE  ? "none for render encoders (diagnostic, unsafe)"
+              : m == KK_BB_BARRIER_VK    ? "vk (render encoders follow the Vulkan barriers)"
+                                         : "legacy ALL->ALL");
+   }
+   return (enum kk_bb_barrier_mode)m;
