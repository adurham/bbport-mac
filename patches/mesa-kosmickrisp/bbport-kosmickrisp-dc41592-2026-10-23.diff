--- a/src/kosmickrisp/bridge/mtl_compiler.m
+++ b/src/kosmickrisp/bridge/mtl_compiler.m
@@ -12,6 +12,337 @@
 #include <Metal/MTL4LibraryFunctionDescriptor.h>
 #include <Metal/MTL4RenderPipeline.h>
 #include <Metal/MTLDevice.h>
+#include <Metal/MTL4Archive.h>
+#include <Metal/MTL4Compiler.h>
+#include <Metal/MTL4PipelineDataSetSerializer.h>
+
+/* bbport (patch 0008): shipped AIR + Metal 4 pipeline archives, all default off.
+ *
+ *   BB_KK_AIR_DIR=<dir>        before compiling MSL source, look for <dir>/<key>.metallib (offline
+ *                              AIR, `xcrun metal`) and load it with newLibraryWithURL. <key> is the
+ *                              BLAKE3 (the hash Mesa's disk cache keys on) of a version tag, the MSL
+ *                              language version, the math mode, the fp32 function mode and the MSL
+ *                              text, in hex. A missing or unloadable file compiles the source as
+ *                              before.
+ *   BB_KK_ARCHIVES=<a>:<b>:... MTL4Archives (base first, then the player's) passed to every render
+ *                              and compute pipeline compile as MTL4CompilerTaskOptions.lookupArchives,
+ *                              so a miss compiles normally. Never archive-only creation. An entry that
+ *                              is a directory loads every *.mtl4archive in it (a capture's segments),
+ *                              in name order.
+ *   BB_KK_ARCHIVE_CAPTURE=1    attach a CaptureBinaries MTL4PipelineDataSetSerializer to the compiler
+ *                              and write it as an archive: on the last compiler release, and (because
+ *                              the port's GPU process ends with _Exit, which never releases it) also
+ *                              from a background thread 5 s after the last new pipeline. Every write
+ *                              is a new segment <dir>/seg-NNNN.mtl4archive, because
+ *                              serializeAsArchiveAndFlushToURL FLUSHES: it empties the serializer, so
+ *                              each write holds only the pipelines created since the previous one
+ *                              (writing one file over and over kept only the last few pipelines).
+ *                              <dir> is $BB_KK_AIR_DIR/capture.archive.d (./kk-capture.archive.d
+ *                              without an AIR dir); any value other than 1 is taken as <dir>. Pass
+ *                              <dir> itself to BB_KK_ARCHIVES.
+ *                              With BB_KK_AIR_DIR set, every library compiled from source is also
+ *                              dumped as <dir>/<key>.metal, listed in <dir>/manifest.txt with the
+ *                              options it must be compiled with.
+ *
+ * With all three unset, bb_air() returns a state with enabled == false and every caller takes the
+ * upstream code path unchanged. CaptureDescriptors is deliberately not set: with it, macOS 27.2's
+ * serializeAsArchiveAndFlushToURL returns NO with a nil error and writes nothing. */
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "util/mesa-blake3.h"
+
+struct bb_air_state {
+   bool enabled;              /* any of the three is set */
+   NSString *air_dir;         /* BB_KK_AIR_DIR or nil */
+   NSArray<NSString *> *archive_paths;
+   NSString *capture_path;    /* nil unless capturing */
+   /* Built once against the first device's compiler. */
+   MTL4CompilerTaskOptions *task_options;
+   id<MTL4PipelineDataSetSerializer> serializer;
+   pthread_rwlock_t capture_lock; /* compiles read, serialize writes */
+   atomic_uint_fast64_t air_hits, air_misses, air_bad, pipelines, flushed_pipelines;
+   atomic_uint_fast64_t lookup_pipelines, fast_pipelines; /* created with lookupArchives / in < 1 ms */
+   unsigned archive_count, segments;
+   atomic_int_fast64_t last_pipeline_ns;
+   pthread_mutex_t flush_mutex;
+};
+
+static struct bb_air_state bb_air_s;
+static pthread_once_t bb_air_once = PTHREAD_ONCE_INIT;
+
+static int64_t
+bb_air_now_ns(void)
+{
+   return (int64_t)clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+static void
+bb_air_init(void)
+{
+   struct bb_air_state *s = &bb_air_s;
+   const char *dir = getenv("BB_KK_AIR_DIR");
+   const char *arcs = getenv("BB_KK_ARCHIVES");
+   const char *cap = getenv("BB_KK_ARCHIVE_CAPTURE");
+   if (dir != NULL && dir[0] != '\0')
+      s->air_dir = [@(dir) retain];
+   if (arcs != NULL && arcs[0] != '\0') {
+      NSMutableArray *list = [NSMutableArray array];
+      for (NSString *p in [@(arcs) componentsSeparatedByString:@":"])
+         if (p.length)
+            [list addObject:p];
+      s->archive_paths = [list copy];
+   }
+   if (cap != NULL && cap[0] != '\0' && strcmp(cap, "0") != 0) {
+      if (strcmp(cap, "1") != 0)
+         s->capture_path = [@(cap) retain];
+      else if (s->air_dir != nil)
+         s->capture_path = [[s->air_dir stringByAppendingPathComponent:@"capture.archive.d"] retain];
+      else
+         s->capture_path = [@"kk-capture.archive.d" retain];
+   }
+   s->enabled = s->air_dir != nil || s->archive_paths.count > 0 || s->capture_path != nil;
+   if (s->enabled) {
+      pthread_rwlock_init(&s->capture_lock, NULL);
+      pthread_mutex_init(&s->flush_mutex, NULL);
+   }
+}
+
+static struct bb_air_state *
+bb_air(void)
+{
+   pthread_once(&bb_air_once, bb_air_init);
+   return &bb_air_s;
+}
+
+/* Writes the capture archive (tmp file + rename, so a reader never sees a half archive). */
+static void
+bb_air_flush(const char *why)
+{
+   struct bb_air_state *s = &bb_air_s;
+   if (s->serializer == nil)
+      return;
+   pthread_mutex_lock(&s->flush_mutex);
+   uint64_t n = atomic_load(&s->pipelines);
+   if (n == atomic_load(&s->flushed_pipelines)) {
+      pthread_mutex_unlock(&s->flush_mutex);
+      return;
+   }
+   @autoreleasepool {
+      mkdir(s->capture_path.UTF8String, 0755);
+      /* The next free segment number (a re-capture into an existing dir appends). */
+      NSString *seg;
+      do {
+         seg = [s->capture_path stringByAppendingPathComponent:
+                                   [NSString stringWithFormat:@"seg-%04u.mtl4archive", s->segments++]];
+      } while (access(seg.UTF8String, F_OK) == 0);
+      NSString *tmp = [seg stringByAppendingString:@".tmp"];
+      int64_t t0 = bb_air_now_ns();
+      pthread_rwlock_wrlock(&s->capture_lock);
+      NSError *error = nil;
+      BOOL ok = [s->serializer serializeAsArchiveAndFlushToURL:[NSURL fileURLWithPath:tmp] error:&error];
+      pthread_rwlock_unlock(&s->capture_lock);
+      double ms = (bb_air_now_ns() - t0) / 1e6;
+      if (ok && rename(tmp.UTF8String, seg.UTF8String) == 0) {
+         struct stat st = {0};
+         stat(seg.UTF8String, &st);
+         uint64_t prev = atomic_load(&s->flushed_pipelines);
+         atomic_store(&s->flushed_pipelines, n);
+         fprintf(stderr, "KK archive: captured pipelines %llu..%llu (%llu new) into %s (%lld bytes, %.1f ms, %s)\n",
+                 (unsigned long long)prev + 1, (unsigned long long)n, (unsigned long long)(n - prev),
+                 seg.UTF8String, (long long)st.st_size, ms, why);
+      } else {
+         fprintf(stderr, "KK archive: capture serialize to %s FAILED (%s)\n", seg.UTF8String,
+                 error ? error.localizedDescription.UTF8String : "no error given");
+      }
+   }
+   pthread_mutex_unlock(&s->flush_mutex);
+}
+
+static void *
+bb_air_thread(void *arg)
+{
+   (void)arg;
+   struct bb_air_state *s = &bb_air_s;
+   uint64_t reported = 0;
+   for (;;) {
+      sleep(2);
+      uint64_t sum = atomic_load(&s->air_hits) + atomic_load(&s->air_misses) + atomic_load(&s->air_bad);
+      if (sum != reported) {
+         reported = sum;
+         fprintf(stderr, "KK air: %llu libraries from AIR, %llu compiled from MSL, %llu AIR files unusable; %llu pipelines "
+                         "(%llu with lookupArchives over %u archives, %llu created in < 1 ms)\n",
+                 (unsigned long long)atomic_load(&s->air_hits), (unsigned long long)atomic_load(&s->air_misses),
+                 (unsigned long long)atomic_load(&s->air_bad), (unsigned long long)atomic_load(&s->pipelines),
+                 (unsigned long long)atomic_load(&s->lookup_pipelines), s->archive_count,
+                 (unsigned long long)atomic_load(&s->fast_pipelines));
+      }
+      if (s->serializer != nil &&
+          atomic_load(&s->pipelines) != atomic_load(&s->flushed_pipelines) &&
+          bb_air_now_ns() - atomic_load(&s->last_pipeline_ns) > 5LL * 1000000000LL)
+         bb_air_flush("5 s after the last new pipeline");
+   }
+   return NULL;
+}
+
+/* Once, for the first compiler: the archives and the serializer. */
+static void
+bb_air_setup(id<MTLDevice> dev, MTL4CompilerDescriptor *desc)
+{
+   struct bb_air_state *s = bb_air();
+   static bool done;
+   if (!s->enabled || done)
+      return;
+   done = true;
+   if (s->archive_paths.count) {
+      NSMutableArray<id<MTL4Archive>> *loaded = [NSMutableArray array];
+      NSMutableArray<NSString *> *files = [NSMutableArray array];
+      for (NSString *p in s->archive_paths) {
+         BOOL is_dir = NO;
+         if ([[NSFileManager defaultManager] fileExistsAtPath:p isDirectory:&is_dir] && is_dir) {
+            NSArray *names = [[[NSFileManager defaultManager] contentsOfDirectoryAtPath:p error:nil]
+               sortedArrayUsingSelector:@selector(compare:)];
+            for (NSString *n in names)
+               if ([n.pathExtension isEqualToString:@"mtl4archive"])
+                  [files addObject:[p stringByAppendingPathComponent:n]];
+         } else {
+            [files addObject:p];
+         }
+      }
+      for (NSString *p in files) {
+         int64_t t0 = bb_air_now_ns();
+         NSError *error = nil;
+         id<MTL4Archive> a = [dev newArchiveWithURL:[NSURL fileURLWithPath:p] error:&error];
+         double ms = (bb_air_now_ns() - t0) / 1e6;
+         if (a == nil) {
+            fprintf(stderr, "KK archive: cannot load %s (%s); skipped\n", p.UTF8String,
+                    error ? error.localizedDescription.UTF8String : "no error given");
+            continue;
+         }
+         [loaded addObject:a];
+         [a release];
+         fprintf(stderr, "KK archive: loaded %s in %.1f ms\n", p.UTF8String, ms);
+      }
+      if (loaded.count) {
+         s->task_options = [MTL4CompilerTaskOptions new];
+         s->task_options.lookupArchives = loaded;
+         s->archive_count = (unsigned)loaded.count;
+      }
+      fprintf(stderr, "KK archive: %u archives passed as lookupArchives to every pipeline\n", s->archive_count);
+   }
+   if (s->capture_path != nil) {
+      MTL4PipelineDataSetSerializerDescriptor *sd = [[MTL4PipelineDataSetSerializerDescriptor new] autorelease];
+      sd.configuration = MTL4PipelineDataSetSerializerConfigurationCaptureBinaries;
+      s->serializer = [dev newPipelineDataSetSerializerWithDescriptor:sd];
+      desc.pipelineDataSetSerializer = s->serializer;
+      fprintf(stderr, "KK archive: capturing into %s\n", s->capture_path.UTF8String);
+   }
+   if (s->air_dir != nil)
+      fprintf(stderr, "KK air: AIR directory %s%s\n", s->air_dir.UTF8String,
+              s->capture_path ? " (misses are dumped there as <key>.metal)" : "");
+   pthread_t thread;
+   if (pthread_create(&thread, NULL, bb_air_thread, NULL) == 0)
+      pthread_detach(thread);
+}
+
+static void
+bb_air_key(const char *src, enum mtl_language_version msl_version, enum mtl_math_mode math_mode,
+           enum mtl_math_floating_point_functions math_fp_fns, char hex[BLAKE3_HEX_LEN])
+{
+   struct mesa_blake3 ctx;
+   _mesa_blake3_init(&ctx);
+   const char tag[] = "bbport-kk-air-1";
+   _mesa_blake3_update(&ctx, tag, sizeof(tag));
+   uint32_t opts[3] = {(uint32_t)msl_version, (uint32_t)math_mode, (uint32_t)math_fp_fns};
+   _mesa_blake3_update(&ctx, opts, sizeof(opts));
+   _mesa_blake3_update(&ctx, src, strlen(src));
+   blake3_hash hash;
+   _mesa_blake3_final(&ctx, hash);
+   _mesa_blake3_format(hex, hash);
+}
+
+/* The xcrun metal flags that reproduce MTLCompileOptions for this key. */
+static void
+bb_air_flags(enum mtl_language_version v, enum mtl_math_mode m, enum mtl_math_floating_point_functions f,
+             char *out, size_t size)
+{
+   snprintf(out, size, "-std=metal%u.%u -fmetal-math-mode=%s -fmetal-math-fp32-functions=%s",
+            ((unsigned)v >> 16) & 0xffff, (unsigned)v & 0xffff,
+            m == MTL_MATH_MODE_FAST ? "fast" : m == MTL_MATH_MODE_RELAXED ? "relaxed" : "safe",
+            f == MTL_MATH_FLOATING_POINT_FUNCTIONS_PRECISE ? "precise" : "fast");
+}
+
+static void
+bb_air_dump(const char *hex, const char *src, enum mtl_language_version v, enum mtl_math_mode m,
+            enum mtl_math_floating_point_functions f)
+{
+   struct bb_air_state *s = &bb_air_s;
+   static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+   NSString *path = [s->air_dir stringByAppendingPathComponent:[NSString stringWithFormat:@"%s.metal", hex]];
+   pthread_mutex_lock(&mutex);
+   if (access(path.UTF8String, F_OK) != 0) {
+      FILE *file = fopen(path.UTF8String, "wb");
+      if (file != NULL) {
+         fwrite(src, 1, strlen(src), file);
+         fclose(file);
+         char flags[160];
+         bb_air_flags(v, m, f, flags, sizeof(flags));
+         NSString *manifest = [s->air_dir stringByAppendingPathComponent:@"manifest.txt"];
+         FILE *mf = fopen(manifest.UTF8String, "a");
+         if (mf != NULL) {
+            fprintf(mf, "%s %s\n", hex, flags);
+            fclose(mf);
+         }
+      }
+   }
+   pthread_mutex_unlock(&mutex);
+}
+
+/* nil = not in the AIR dir (or unusable): the caller compiles the source. */
+static id<MTLLibrary>
+bb_air_library(id<MTL4Compiler> comp, const char *hex)
+{
+   struct bb_air_state *s = &bb_air_s;
+   NSString *path = [s->air_dir stringByAppendingPathComponent:[NSString stringWithFormat:@"%s.metallib", hex]];
+   if (access(path.UTF8String, R_OK) != 0)
+      return nil;
+   NSError *error = nil;
+   id<MTLLibrary> lib = [comp.device newLibraryWithURL:[NSURL fileURLWithPath:path] error:&error];
+   if (lib == nil) {
+      atomic_fetch_add(&s->air_bad, 1);
+      fprintf(stderr, "KK air: %s unusable (%s); compiling the MSL\n", path.UTF8String,
+              error ? error.localizedDescription.UTF8String : "no error given");
+   }
+   return lib;
+}
+
+static void
+bb_air_pipeline_created(int64_t ns)
+{
+   struct bb_air_state *s = &bb_air_s;
+   if (s->task_options != nil)
+      atomic_fetch_add(&s->lookup_pipelines, 1);
+   if (ns < 1000000)
+      atomic_fetch_add(&s->fast_pipelines, 1);
+   atomic_fetch_add(&s->pipelines, 1);
+   atomic_store(&s->last_pipeline_ns, bb_air_now_ns());
+}
+
+void
+mtl_compiler_bb_release(mtl_compiler *compiler)
+{
+   (void)compiler;
+   struct bb_air_state *s = bb_air();
+   if (s->enabled)
+      bb_air_flush("last compiler release");
+}
