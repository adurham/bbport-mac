+/* bbport (BB_COMMIT_TRACE, docs/FRAME_HANDOFF_WAIT.md) ------------------------------
+ * One counter, off unless BB_COMMIT_TRACE=1: which of the queue's two GPU waits
+ * (:274 event, :294 drawable) was enqueued ahead of each Metal commit, and how long the
+ * GPU sat idle before it started that commit. The GPU's own stamps come from the MTL4
+ * commit feedback (GPUStartTime/GPUEndTime), so dry_ms is measured on the GPU's clock,
+ * not on ours: dry = this commit's gpu_start - the last gpu_end the queue reported.
+ * No behaviour change: the waits, the commits and their order are untouched. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <mach/mach_time.h>
+
+#include "util/u_debug.h"
+
+#define KK_TRACE_NONE 0
+#define KK_TRACE_EVENT 1
+#define KK_TRACE_DRAWABLE 2
+#define KK_TRACE_DRY_DETAIL_NS 300000ll /* print a commit that started >= 0.3 ms late */
+
+static const char *const kk_trace_tag_name[3] = {"none", "event", "drawable"};
+
+/* What the WSI hands over about the wait it just enqueued (NULL when nothing was traced). */
+struct kk_trace_wait {
+   uint8_t tag;
+   int64_t ns;      /* host time the wait went into the queue */
+   uint64_t value;  /* event waits: the timeline value waited for */
+};
+
+struct kk_trace_commit {
+   mtl_feedback_handler_callback callback;
+   void *user_data;
+   uint64_t seq;
+   uint64_t wait_value;
+   int64_t commit_ns;
+   int64_t wait_ns;
+   uint32_t n_cb;
+   uint32_t inflight;
+   uint8_t tag;
+   uint8_t rerecord;
+};
+
+static struct {
+   bool enabled;
+   bool full; /* BB_COMMIT_TRACE_FULL=1: every commit on its own line */
+   mtx_t lock;
+   double last_end; /* latest gpu_end reported by any commit, seconds */
+   uint64_t seq;
+   int64_t t0_ns;
+   int64_t window_start_ns; /* start of the window being summarised */
+   uint32_t win_commits;
+   uint32_t win_tag[3];
+   uint32_t win_over[3];   /* dry >= 0.5 ms */
+   uint32_t win_over10[3]; /* dry >= 1.0 ms: the frame-handoff band */
+   int64_t win_dry_sum[3];
+   int64_t win_busy_sum[3];
+   int64_t win_dry_max[3];
+   uint32_t win_inflight_max;
+   uint32_t printed;
+} kk_trace;
+
+#define KK_TRACE_WINDOW_NS 2000000000ll /* one summary every 2 s */
+
+static once_flag kk_trace_once = ONCE_FLAG_INIT;
+/* Drawables the WSI handed out and the queue has not signalled back yet. */
+static int kk_trace_inflight;
+
+static void kk_trace_window_locked(int64_t now, bool force);
+
+
+static int64_t
+kk_trace_now_ns(void)
+{
+   static mach_timebase_info_data_t tb;
+   if (tb.denom == 0)
+      mach_timebase_info(&tb);
+   const uint64_t t = mach_absolute_time();
+   return (int64_t)((t / tb.denom) * tb.numer + ((t % tb.denom) * tb.numer) / tb.denom);
+}
+
+static void
+kk_trace_init(void)
+{
+   mtx_init(&kk_trace.lock, mtx_plain);
+   kk_trace.enabled = debug_get_bool_option("BB_COMMIT_TRACE", false);
+   kk_trace.full = debug_get_bool_option("BB_COMMIT_TRACE_FULL", false);
+   kk_trace.t0_ns = kk_trace_now_ns();
+   kk_trace.window_start_ns = kk_trace.t0_ns;
+   if (kk_trace.enabled)
+      fprintf(stderr, "BBCT start t0_ms=%.3f full=%d\n", (double)kk_trace.t0_ns / 1e6,
+              kk_trace.full);
+}
+
+/* The last window would otherwise never be printed (kk_queue_finish). */
+void
+kk_commit_trace_flush(void)
+{
+   if (!kk_commit_trace_enabled())
+      return;
+   mtx_lock(&kk_trace.lock);
+   kk_trace_window_locked(kk_trace_now_ns(), true);
+   mtx_unlock(&kk_trace.lock);
+}
+
+bool
+kk_commit_trace_enabled(void)
+{
+   call_once(&kk_trace_once, kk_trace_init);
+   return kk_trace.enabled;
+}
+
+bool
+kk_commit_trace_full(void)
+{
+   call_once(&kk_trace_once, kk_trace_init);
+   return kk_trace.full;
+}
+
+uint32_t
+kk_commit_trace_inflight(void)
+{
+   return (uint32_t)p_atomic_read(&kk_trace_inflight);
+}
+
+/* Called by the WSI (wsi_common_metal_layer.m) when nextDrawable returns. */
+void
+kk_commit_trace_drawable_acquired(void)
+{
+   if (!kk_commit_trace_enabled())
+      return;
+   p_atomic_add(&kk_trace_inflight, 1);
+}
+
+/* Called when the queue signals a drawable back to the compositor. */
+void
+kk_commit_trace_drawable_signalled(void)
+{
+   if (!kk_commit_trace_enabled())
+      return;
+   p_atomic_add(&kk_trace_inflight, -1);
+}
+
+static void
+kk_trace_window_locked(int64_t now, bool force)
+{
+   const int64_t span = now - kk_trace.window_start_ns;
+   if (!force && span < KK_TRACE_WINDOW_NS)
+      return;
+   if (kk_trace.win_commits == 0) {
+      kk_trace.window_start_ns = now;
+      return;
+   }
+
+   const double us = 1.0 / 1e3; /* ns -> us */
+   fprintf(stderr,
+           "BBCT window=%.0fms commits=%u busy_ms=%.1f dry_ms=%.1f over500=%u over1000=%u "
+           "none=%u/dry%.1fms/busy%.1fms/peak%.0fus/o500=%u/o1000=%u "
+           "event=%u/dry%.1fms/busy%.1fms/peak%.0fus/o500=%u/o1000=%u "
+           "drawable=%u/dry%.1fms/busy%.1fms/peak%.0fus/o500=%u/o1000=%u inflight_max=%u\n",
+           (double)span / 1e6, kk_trace.win_commits,
+           (double)(kk_trace.win_busy_sum[0] + kk_trace.win_busy_sum[1] +
+                    kk_trace.win_busy_sum[2]) / 1e6,
+           (double)(kk_trace.win_dry_sum[0] + kk_trace.win_dry_sum[1] +
+                    kk_trace.win_dry_sum[2]) / 1e6,
+           kk_trace.win_over[0] + kk_trace.win_over[1] + kk_trace.win_over[2],
+           kk_trace.win_over10[0] + kk_trace.win_over10[1] + kk_trace.win_over10[2],
+           kk_trace.win_tag[0], (double)kk_trace.win_dry_sum[0] / 1e6,
+           (double)kk_trace.win_busy_sum[0] / 1e6, (double)kk_trace.win_dry_max[0] * us,
+           kk_trace.win_over[0], kk_trace.win_over10[0],
+           kk_trace.win_tag[1], (double)kk_trace.win_dry_sum[1] / 1e6,
+           (double)kk_trace.win_busy_sum[1] / 1e6, (double)kk_trace.win_dry_max[1] * us,
+           kk_trace.win_over[1], kk_trace.win_over10[1],
+           kk_trace.win_tag[2], (double)kk_trace.win_dry_sum[2] / 1e6,
+           (double)kk_trace.win_busy_sum[2] / 1e6, (double)kk_trace.win_dry_max[2] * us,
+           kk_trace.win_over[2], kk_trace.win_over10[2],
+           kk_trace.win_inflight_max);
+
+   kk_trace.window_start_ns = now;
+   kk_trace.win_commits = 0;
+   kk_trace.win_inflight_max = 0;
+   for (unsigned i = 0; i < 3; i++) {
+      kk_trace.win_tag[i] = 0;
+      kk_trace.win_over[i] = 0;
+      kk_trace.win_over10[i] = 0;
+      kk_trace.win_dry_sum[i] = 0;
+      kk_trace.win_busy_sum[i] = 0;
+      kk_trace.win_dry_max[i] = 0;
+   }
+}
+
+static void
+kk_trace_record(struct kk_trace_commit *t, double gpu_start, double gpu_end)
+{
+   const bool have = gpu_start > 0.0 && gpu_end > 0.0;
+   const int64_t now = kk_trace_now_ns();
+   int64_t dry_ns = 0;
+   bool print;
+
+   mtx_lock(&kk_trace.lock);
+
+   if (have && kk_trace.last_end > 0.0)
+      dry_ns = (int64_t)((gpu_start - kk_trace.last_end) * 1e9);
+   if (have && gpu_end > kk_trace.last_end)
+      kk_trace.last_end = gpu_end;
+
+   const uint8_t tag = t->tag > 2 ? 0 : t->tag;
+   kk_trace.win_tag[tag]++;
+   if (dry_ns > 0)
+      kk_trace.win_dry_sum[tag] += dry_ns;
+   if (have && gpu_end > gpu_start)
+      kk_trace.win_busy_sum[tag] += (int64_t)((gpu_end - gpu_start) * 1e9);
+   if (dry_ns > kk_trace.win_dry_max[tag])
+      kk_trace.win_dry_max[tag] = dry_ns;
+   if (dry_ns >= 500000)
+      kk_trace.win_over[tag]++;
+   if (dry_ns >= 1000000)
+      kk_trace.win_over10[tag]++;
+   if (t->inflight > kk_trace.win_inflight_max)
+      kk_trace.win_inflight_max = t->inflight;
+   kk_trace.win_commits++;
+
+   /* A detail line for the interesting middle band: not a load hitch (>= 12 ms is the queue
