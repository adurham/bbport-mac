+ * render encoder instead of splitting the pass (kk_render_defer.h, hoist).
+ * Read once per process. */
+bool kk_bb_defer_hoist(void);
+/* bbport (BB_KK_BARRIER): end-of-encoder barrier policy.
+ *   legacy (default)  every encoder ends with barrierAfterStages(ALL, ALL)
+ *   lite              render encoders end with barrierAfterStages(ALL, ALL & ~vertex):
+ *                     later encoders' vertex front end may overlap this pass's
+ *                     fragment work; a Vulkan barrier (or command) that a vertex
+ *                     stage may depend on makes the next render encoder wait for
+ *                     all prior work before its vertex stage and end full.
+ *   nodep             (diagnostic only, UNSAFE) lite without the vertex waits: the
+ *                     upper bound of what the overlap can give. */
+enum kk_bb_barrier_mode {
+   KK_BB_BARRIER_LEGACY = 0,
+   KK_BB_BARRIER_LITE = 1,
+   KK_BB_BARRIER_NODEP = 2,
+   /* (diagnostic only, UNSAFE) render encoders end with no barrier at all:
+    * the ceiling of the whole end-of-render-encoder barrier lever. */
+   KK_BB_BARRIER_NONE = 3,
+   /* vk: render encoders end with no producer barrier; the application's
+    * own Vulkan barriers (vkCmdPipelineBarrier2) become Metal consumer
+    * barriers (barrierAfterQueueStages(ALL, dst)) at the next encoder. KK's
+    * own hidden dependencies stay ordered: compute/blit encoders start with a
+    * consumer barrier on all prior work and end full; render-pass restarts,
+    * meta ops, queries, events, markers and every command buffer start make
+    * the next render encoder wait on all prior work. Two render passes with
+    * no Vulkan barrier between them may overlap on the GPU, as Vulkan allows:
+    * a dependency the port forgot to declare becomes a visible race. */
+   KK_BB_BARRIER_VK = 4,
+};
+enum kk_bb_barrier_mode kk_bb_barrier_mode(void);
+
 #endif // KK_DEVICE_H
