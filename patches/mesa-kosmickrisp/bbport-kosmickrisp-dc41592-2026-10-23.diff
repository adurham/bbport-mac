+   if (cmd->gfx.cmd_buf == NULL ||
+       (cmd->bb_one_cb_passes + cmd->bb_one_cb_folded == 0u && !folded_open))
+      return; /* nothing earlier shares the buffer: order already right */
+
+   data->restart = dyn->ia.primitive_restart_enable;
+   data->restart_index = dyn->ia.primitive_restart_index;
+   data->flatshade_first =
+      dyn->rs.provoking_vertex == VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT;
+   const bool tess = cmd->state.shaders[MESA_SHADER_TESS_EVAL];
+   if (!(data->predicate_count > 0 || tess || requires_unroll(cmd, data)))
+      return;
+
+   /* bbport (BB_KK_FLUSH_LOG): captured before cs_end() closes it, because
+    * the F line reports the state at the moment of the request. */
+   const bool split_open = kk_renc_mtl_open(cmd);
+   /* bbport (BB_KK_FLUSH_LOG): which state's work asked for this end. A draw
+    * split exists for THIS draw's pre-gfx work (indirect predicate, tessellation
+    * or unroll, encoded before the draw), which has to land ahead of the pass, so
+    * which=pre; the folded compute encoder below is only what occupies the
+    * buffer. The exception is a folded post-gfx compute encoder with no ended
+    * pass in the buffer (passes == 0): then that post-gfx work is what has to be
+    * ended first, which=post. Both facts are read before cs_end() below, which
+    * stops the compute encoders and swaps the pre/post slots. */
+   struct kk_encoder_state *const bb_req =
+      cmd->pre_gfx->encoder && cmd->pre_gfx->bb_folded    ? cmd->pre_gfx
+      : cmd->post_gfx->encoder && cmd->post_gfx->bb_folded ? cmd->post_gfx
+                                                           : NULL;
+   const enum kk_bb_flush_which bb_which =
+      bb_req != NULL ? kk_bb_which_of(bb_req)
+      : cmd->bb_one_cb_passes > 0u
+      ? KK_BB_WHICH_PRE /* this draw's own pre-gfx work */
+      : KK_BB_WHICH_OTHER; /* unreachable: the guard above returned unless a
+                            * pass or a folded encoder held the buffer */
+   if (kk_renc_is_open(cmd)) {
+      kk_apply_attachment_store_ops(cmd, true);
+      cs_end(cmd);
+      kk_cmd_buffer_dirty_all_gfx(cmd);
+      cmd->state.gfx.need_to_start_render_pass = true;
+      kk_bbstat_add(KK_BBSTAT_ONECB_SPLITS, 1);
+      if (cmd->bb_one_cb_passes == 0u) /* only the fold made it necessary */
+         kk_bbstat_add(KK_BBSTAT_ONECB_FOLD_SPLITS, 1);
+   }
+   /* bbport (BB_KK_FLUSH_LOG): encoder=open when the pass above had to be
+    * split in place to get the shared buffer ended; the flush below then runs
+    * with the encoder closed, so this is captured before cs_end(). */
+   kk_bb_one_cb_flush(cmd, KK_BB_FLUSH_DRAW_SPLIT, split_open, bb_which,
+                      kk_bb_pending_writes(bb_req));
+   kk_bbstat_add(KK_BBSTAT_ONECB_EARLY_ENDS, 1);
+}
+
+/* bbport (M2, BB_KK_DEFER_HOIST): the hoist gate for a draw with pre-gfx
+ * work, evaluated before kk_bb_one_cb_draw_split (a hoisted draw needs no
+ * split). Same conditions as kk_draw below, on the same fields. The reads
+ * are the ones the draw's pre side ops will decode from their arguments that
+ * are known now (indirect args, predicates, index buffer); the rest are pool
+ * allocations of this draw or outputs of its own (hoisted) earlier side ops.
+ * Tessellation runs the app's VS/TCS in compute (kk_renc_tess_side_flags:
+ * KK_RENC_SIDE_SHADER, gated by the pass write-set predicate) and always
+ * allocates from the geometry heap (kk_upload_tess_params), so like an
+ * unroll its first heap use emits the heap reset. heap_first only matters
+ * for a draw refused for another reason (then HEAP is still reported, and
+ * the reset stays in-pass post-gfx work); a hoisted draw takes the reset
+ * with it as a pre side op (kk_heap). Returns false (no hoist) when the draw
+ * has no pre-gfx work. */
+static bool
+kk_bb_hoist_gate(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
+{
+   struct vk_dynamic_graphics_state *dyn = &cmd->vk.dynamic_graphics_state;
+
+   cmd->renc.hoist_draw = false;
+   data->restart = dyn->ia.primitive_restart_enable;
+   data->restart_index = dyn->ia.primitive_restart_index;
+   data->flatshade_first =
+      dyn->rs.provoking_vertex == VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT;
+   const bool tess = cmd->state.shaders[MESA_SHADER_TESS_EVAL];
+   const bool unroll = requires_unroll(cmd, data);
+   if (!(data->predicate_count > 0 || tess || unroll))
+      return false;
+
+   uint64_t reads[4];
+   uint32_t nr = 0u;
+   for (uint32_t i = 0; i < data->predicate_count && i < 2u; i++)
+      reads[nr++] = data->predicate_addr[i];
+   if (data->indirect)
+      reads[nr++] = data->indirect_command.addr;
+   if (unroll && data->indexed)
+      reads[nr++] = data->index_buffer.addr;
+   return kk_renc_hoist_draw(cmd, tess ? kk_renc_tess_side_flags(cmd) : 0u,
+                             reads, nr, (unroll || tess) && !cmd->uses_heap);
+}
+
+static void kk_draw_body(struct kk_cmd_buffer *cmd,
+                         struct kk_draw_command *data);
+
 static void
 kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
+{
+   /* bbport (M2): a hoisted draw's pre-gfx work goes ahead of its pass's
+    * render encoder on the shared buffer, so the pass is not split for it. */
+   const bool hoist = unlikely(cmd->renc.hoist) && kk_bb_hoist_gate(cmd, data);
+   if (unlikely(kk_bb_one_cmdbuf()) && !hoist)
+      kk_bb_one_cb_draw_split(cmd, data);
+   kk_draw_body(cmd, data);
+   kk_renc_hoist_draw_end(cmd);
+}
