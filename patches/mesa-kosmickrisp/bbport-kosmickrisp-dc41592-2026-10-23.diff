+/* bbport (compaction probe): see kk_device.h. The deadline is a monotonic
+ * (os_time_get_nano) time computed once from the process start time (sysctl
+ * KERN_PROC_PID p_starttime, wall clock), so the armed check at begin is one
+ * clock read and one compare, and the bump itself is a single cmpxchg 0 -> 1:
+ * nothing ever writes kk_bb_compact_gen back to 0, so there is no second bump. */
+uint32_t kk_bb_compact_gate;
+uint32_t kk_bb_compact_gen;
+static int64_t kk_bb_compact_deadline_ns;
+static util_once_flag kk_bb_compact_once = UTIL_ONCE_FLAG_INIT;
+
+static void
+kk_bb_compact_init_once(void)
+{
+   const char *s = getenv("BB_KK_COMPACT_AT");
+   if (s == NULL || s[0] == '\0')
+      return; /* gate stays 0: begin is unchanged */
+
+   char *end = NULL;
+   const double at_s = strtod(s, &end);
+   if (end == s || *end != '\0' || !(at_s >= 0.0) || at_s > 1e6) {
+      fprintf(stderr, "KosmicKrisp: BB_KK_COMPACT_AT=%s: not a number of seconds "
+                      "(0..1e6); compaction off\n", s);
+      return;
+   }
+
+   struct timeval now_wall;
+   gettimeofday(&now_wall, NULL);
+   const int64_t now_mono = os_time_get_nano();
+   const int64_t now_wall_ns =
+      (int64_t)now_wall.tv_sec * 1000000000ll + (int64_t)now_wall.tv_usec * 1000ll;
+
+   int64_t start_wall_ns = now_wall_ns; /* fallback: driver init time */
+   const char *origin = "process start";
+   struct kinfo_proc kp;
+   size_t len = sizeof(kp);
+   int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PID, (int)getpid()};
+   if (sysctl(mib, 4, &kp, &len, NULL, 0) == 0 && len == sizeof(kp)) {
+      start_wall_ns = (int64_t)kp.kp_proc.p_starttime.tv_sec * 1000000000ll +
+                      (int64_t)kp.kp_proc.p_starttime.tv_usec * 1000ll;
+   } else {
+      origin = "driver init (sysctl KERN_PROC_PID failed)";
+   }
+   const int64_t elapsed_ns = now_wall_ns - start_wall_ns;
+   kk_bb_compact_deadline_ns = now_mono + (int64_t)(at_s * 1e9) - elapsed_ns;
+
+   fprintf(stderr,
+           "KosmicKrisp: BB_KK_COMPACT_AT=%s: one command-allocator compaction "
+           "at the first begin %.3f s after %s (driver initialised at %.3f s)\n",
+           s, at_s, origin, (double)elapsed_ns / 1e9);
+   p_atomic_set(&kk_bb_compact_gate, 1u);
+}
+
+void
+kk_bb_compact_init(void)
+{
+   util_call_once(&kk_bb_compact_once, kk_bb_compact_init_once);
+}
+
+uint32_t
+kk_bb_compact_maybe_bump(void)
+{
+   const uint32_t gen = p_atomic_read(&kk_bb_compact_gen);
+   if (gen != 0u)
+      return gen; /* already bumped: never again */
+   const int64_t now = os_time_get_nano();
+   if (now < kk_bb_compact_deadline_ns)
+      return 0u;
+   /* Exactly one thread wins 0 -> 1; the losers read the 1 it wrote. */
+   if (p_atomic_cmpxchg(&kk_bb_compact_gen, 0u, 1u) == 0u) {
+      fprintf(stderr, "KosmicKrisp: BB_KK_COMPACT_AT: compaction generation 1 "
+                      "(%.3f s after the deadline)\n",
+              (double)(now - kk_bb_compact_deadline_ns) / 1e9);
+      FILE *log = kk_bb_alloc_log();
+      if (log != NULL)
+         fprintf(log, "G %" PRIu64 " gen=1\n", kk_bb_alloc_log_seq());
+   }
+   return p_atomic_read(&kk_bb_compact_gen);
+}
